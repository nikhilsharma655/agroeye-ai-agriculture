# --- Database ---
DATABASE_URL=postgresql://agroeye:agroeye_password@localhost:5432/agroeye_db
# For local dev without Postgres, you can instead use:
# DATABASE_URL=sqlite:///./agroeye.db

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- n8n integration ---
N8N_BASE_URL=http://localhost:5678
N8N_FARM_ALERT_WEBHOOK_URL=http://localhost:5678/webhook/agroeye/farm-alert
N8N_IRRIGATION_ALERT_WEBHOOK_URL=http://localhost:5678/webhook/agroeye/irrigation-alert
N8N_RECOMMENDATION_WEBHOOK_URL=http://localhost:5678/webhook/agroeye/recommendation
N8N_WEBHOOK_SHARED_SECRET=change_this_shared_secret

# --- App ---
APP_ENV=development
APP_NAME=AgroEye
API_V1_PREFIX=/api
